{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Game": {
    "MaxPlayers": 4,
    "MinPlayers": 2
  },
  "Ai": {
    "Provider": "Scripted",
    "TokenScope": "https://ai.azure.com/.default",
    "Calls": {
      "Chat": { "ReasoningEffort": "minimal", "MaxOutputTokens": 400, "TimeoutMs": 6000 },
      "Vote": { "ReasoningEffort": "minimal", "MaxOutputTokens": 300, "TimeoutMs": 8000 },
      "Onboarding": { "ReasoningEffort": "low", "MaxOutputTokens": 1500, "TimeoutMs": 15000 },
      "Questions": { "ReasoningEffort": "medium", "MaxOutputTokens": 5000, "TimeoutMs": 30000 },
      "RoundNotes": { "ReasoningEffort": "low", "MaxOutputTokens": 1500, "TimeoutMs": 15000 }
    },
    "Limits": {
      "MaxConcurrentCalls": 8,
      "MaxCallsPerGame": 150,
      "DailyTokenBudget": 5000000,
      "MaxAiGames": 20,
      "CircuitFailures": 5,
      "CircuitOpenSeconds": 60
    }
  },
  "Storage": {
    "Provider": "InMemory",
    "ArchiveTranscripts": false,
    "Blob": { "ServiceUri": "", "ArchiveContainer": "turingtown-transcripts" }
  },
  "ContentSafety": {
    "Provider": "None",
    "FamilyThreshold": 2,
    "MatureThreshold": 4,
    "TimeoutMs": 2000,
    "FailOpen": true
  },
  "RateLimits": {
    "RoomRequestsPerMinute": 60
  }
}