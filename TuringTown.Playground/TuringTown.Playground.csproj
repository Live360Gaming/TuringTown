<Project Sdk="Microsoft.NET.Sdk">

    <!-- A console playground for the bots: chat with them as the humans, against the real model or the scripted bots.
         Not part of the game and never deployed. See README.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\TuringTown.csproj" />
    </ItemGroup>

</Project>
