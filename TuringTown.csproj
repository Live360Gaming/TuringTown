<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>4295d1b4-28d5-4e6e-baaf-79201d9c609a</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.AI.ContentSafety" Version="1.0.0" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="OpenAI" Version="2.15.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Services\Ai\Prompts\*.md" />
        <!-- Each minigame's definition (game/src/minigames/<id>/data/game.json): the server reads its "enabled" flag. -->
        <EmbeddedResource Include="game\src\minigames\*\data\game.json" />
    </ItemGroup>

    <!-- The test project lives in a subfolder, so keep its sources out of this project's globbing. -->
    <ItemGroup>
      <Compile Remove="TuringTown.Tests\**" />
      <Content Remove="TuringTown.Tests\**" />
      <None Remove="TuringTown.Tests\**" />
      <EmbeddedResource Remove="TuringTown.Tests\**" />
      <InternalsVisibleTo Include="TuringTown.Tests" />
    </ItemGroup>

    <!-- The bot playground (see TuringTown.Playground/README.md) lives in a subfolder too. -->
    <ItemGroup>
      <Compile Remove="TuringTown.Playground\**" />
      <Content Remove="TuringTown.Playground\**" />
      <None Remove="TuringTown.Playground\**" />
      <EmbeddedResource Remove="TuringTown.Playground\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="transcripts\**" />
      <None Remove="transcripts\**" />
      <None Remove="game\public\assets\preloader.png" />
    </ItemGroup>

</Project>
